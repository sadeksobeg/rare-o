generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Launch browse: oud-economy, oud-mid, oud-professional, oud-vip, accessories.
/// string-instruments is retained as a protected legacy bucket.
model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameAr    String
  nameEn    String
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                String                 @id @default(cuid())
  slug              String                 @unique
  nameAr            String                 @default("")
  nameEn            String                 @default("")
  descriptionAr     String                 @default("")
  descriptionEn     String                 @default("")
  specsTextAr       String                 @default("")
  specsTextEn       String                 @default("")
  /// Optional structured oud wood / measure / finish details (admin-filled)
  oudSpecs          Json?
  categoryId        String
  category          Category               @relation(fields: [categoryId], references: [id])
  /// Nullable with currency as a pair (D28b): both set or both null = price on request
  retailPrice       Decimal?
  /// Optional prior / compare-at price; badge only when > retailPrice (admin-set, never invented)
  compareAtPrice    Decimal?
  /// Nullable with retailPrice (D28b)
  currency          String?
  /// draft | published | archived
  status            String                 @default("draft")
  /// available | unavailable — public retail flag ONLY (not inventory)
  availability      String                 @default("available")
  /// Forward-looking flag for Week 3; no wholesale UI in Week 2
  wholesaleEligible Boolean                @default(false)
  /// Admin storefront badges (independent toggles)
  badgeNew          Boolean                @default(false)
  badgeFeatured     Boolean                @default(false)
  badgeSale         Boolean                @default(false)
  images            ProductImage[]
  requestLines      RetailRequestLine[]
  dealProposals     DealProposal[]
  curatedOffers     PublicCuratedOffer[]
  wholesaleLines    WholesaleRequestLine[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

/// Admin-managed homepage / storefront flyer bands (no fake content when unpublished)
model PromoBand {
  id         String    @id @default(cuid())
  slug       String    @unique
  titleAr    String    @default("")
  titleEn    String    @default("")
  bodyAr     String    @default("")
  bodyEn     String    @default("")
  ctaLabelAr String    @default("")
  ctaLabelEn String    @default("")
  /// Internal path only, e.g. /catalog or /offers/slug — validated in Zod
  href       String
  /// ink | plum | sand
  tone       String    @default("ink")
  imagePath  String?
  sortOrder  Int       @default(0)
  /// draft | published
  status     String    @default("draft")
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, sortOrder])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  altAr     String  @default("")
  altEn     String  @default("")
  sortOrder Int     @default(0)
  /// image | video | audio
  kind      String  @default("image")
}

/// Contact record — phone is NOT a unique business identity
model Customer {
  id                    String                 @id @default(cuid())
  name                  String
  phone                 String
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  requests              RetailRequest[]
  whatsAppConversations WhatsAppConversation[]

  @@index([phone])
}

model RetailRequest {
  id                   String               @id @default(cuid())
  reference            String               @unique
  locale               String
  /// draft | ready_for_handoff | handoff_opened | in_follow_up | completed | cancelled
  status               String               @default("draft")
  customerName         String
  customerPhone        String
  customerNotes        String               @default("")
  destinationCountry   String
  /// ISO-ish code into lib/shipping/rates.ts zones, or a Syria governorate
  /// code — null for requests placed before the shipping calculator shipped
  destinationCode      String?
  shippingMethodCode   String?
  shippingMethodLabel  String?
  /// Calculator estimate, not a charge — platform has no payment gateway
  shippingCostAmount   Decimal?
  shippingCostCurrency String?
  shippingWeightKg     Decimal?
  subtotal             Decimal
  currency             String
  handoffPayloadJson   String
  /// Stored/generated WhatsApp prefilled message text (Week 3 wa.me handoff)
  handoffMessageText   String?
  /// Built wa.me deep link — no WhatsApp Business API
  whatsAppDeepLink     String?
  /// Client-generated UUID — makes storefront submit idempotent
  idempotencyKey       String?              @unique
  handoffPreparedAt    DateTime?
  handoffOpenedAt      DateTime?
  customerId           String?
  customer             Customer?            @relation(fields: [customerId], references: [id])
  lines                RetailRequestLine[]
  handoffEvents        RetailHandoffEvent[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status])
  @@index([customerPhone])
}

/// Auditable handoff / status events for RetailRequest (not a chat log)
model RetailHandoffEvent {
  id           String        @id @default(cuid())
  requestId    String
  request      RetailRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// prepared | opened | retriggered | status_changed
  eventType    String
  fromStatus   String?
  toStatus     String?
  /// customer | admin
  actor        String
  actorAdminId String?
  note         String?
  createdAt    DateTime      @default(now())

  @@index([requestId])
}

model RetailRequestLine {
  id                String        @id @default(cuid())
  requestId         String
  request           RetailRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameAr     String
  productNameEn     String
  quantity          Int
  unitPriceSnapshot Decimal
  lineTotal         Decimal
  currency          String
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  /// Encrypted TOTP secret (AES via AUTH_SECRET); null until 2FA enrolled
  totpSecretEnc      String?
  /// JSON array of bcrypt-hashed one-time recovery codes
  totpRecoveryHashes String    @default("[]")
  totpEnabledAt      DateTime?
  /// Forces the change-password screen on next sign-in (e.g. after a reset)
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
}

/// Append-only admin audit trail (F3)
model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  target    String   @default("")
  metaJson  String   @default("{}")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

/// Minimal admin-provisioned trader identity — not a marketplace seller account
model TraderAccount {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  passwordHash          String
  displayName           String
  companyName           String                 @default("")
  phone                 String                 @default("")
  /// active | disabled
  status                String                 @default("active")
  adminNotes            String                 @default("")
  /// Comma-separated launch category slugs the trader is interested in
  interestCategorySlugs String                 @default("")
  /// Free-text deal preferences for admin matching
  interestNotes         String                 @default("")
  /// Forces the change-password screen on next sign-in (e.g. after an admin reset)
  mustChangePassword    Boolean                @default(false)
  passwordChangedAt     DateTime?
  deals                 DealProposal[]
  wholesaleRequests     WholesaleRequest[]
  brokerageRequests     BrokerageRequest[]
  notifications         TraderNotification[]
  whatsAppConversations WhatsAppConversation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

/// In-app status center for traders (deals + wholesale + brokerage) — pull inbox, not push.
model TraderNotification {
  id        String        @id @default(cuid())
  traderId  String
  trader    TraderAccount @relation(fields: [traderId], references: [id], onDelete: Cascade)
  /// deal | wholesale | brokerage | system
  domain    String
  titleAr   String
  titleEn   String
  bodyAr    String        @default("")
  bodyEn    String        @default("")
  href      String
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([traderId, createdAt])
  @@index([traderId, readAt])
}

/// Trader commercial deal proposal — separate from RetailRequest / Wholesale
model DealProposal {
  id                        String               @id @default(cuid())
  reference                 String               @unique
  traderId                  String
  trader                    TraderAccount        @relation(fields: [traderId], references: [id], onDelete: Restrict)
  /// catalog | non_catalog
  dealKind                  String
  title                     String
  /// Catalog deals may reference an existing RARE OUD Product (ownership stays with RARE OUD)
  productId                 String?
  product                   Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Trader-stated price (required on new creates — payment-first, 2026-11-03)
  proposedPrice             Decimal?
  currency                  String?
  quantity                  Int?
  conditionsNotes           String               @default("")
  /// Model / SKU identifier (replaces category language on deals UI)
  modelNumber               String               @default("")
  /// proposed | negotiating | accepted | awaiting_payment | payment_confirmed | rejected | closed
  status                    String               @default("proposed")
  /// WhatsApp payment handoff (additive — mirrors retail pattern; no online pay)
  handoffMessageText        String?
  whatsAppDeepLink          String?
  handoffPreparedAt         DateTime?
  handoffOpenedAt           DateTime?
  paymentConfirmedAt        DateTime?
  paymentConfirmedByAdminId String?
  entries                   NegotiationEntry[]
  curatedOffers             PublicCuratedOffer[]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@index([traderId])
  @@index([status])
  @@index([dealKind])
}

/// Structured, auditable negotiation history — not real-time chat
model NegotiationEntry {
  id              String       @id @default(cuid())
  dealId          String
  deal            DealProposal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// propose | continue | counter | accept | close
  action          String
  /// trader | admin
  actorRole       String
  actorTraderId   String?
  actorAdminId    String?
  message         String       @default("")
  proposedPrice   Decimal?
  currency        String?
  quantity        Int?
  conditionsNotes String?
  createdAt       DateTime     @default(now())

  @@index([dealId])
}

/// Optional curated public presentation — never auto-created from a deal
model PublicCuratedOffer {
  id             String        @id @default(cuid())
  slug           String        @unique
  titleAr        String        @default("")
  titleEn        String        @default("")
  summaryAr      String        @default("")
  summaryEn      String        @default("")
  /// draft | published | unpublished
  status         String        @default("draft")
  /// Optional source reference only — publishing is always an explicit admin action
  dealProposalId String?
  dealProposal   DealProposal? @relation(fields: [dealProposalId], references: [id], onDelete: SetNull)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  sortOrder      Int           @default(0)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([dealProposalId])
}

/// Wholesale trader ordering — separate from RetailRequest and DealProposal
model WholesaleRequest {
  id                   String                  @id @default(cuid())
  reference            String                  @unique
  traderId             String
  trader               TraderAccount           @relation(fields: [traderId], references: [id], onDelete: Restrict)
  /// request_quote | propose_price
  requestMode          String
  /// submitted | under_review | quote_provided | confirmed | completed | cancelled
  status               String                  @default("submitted")
  traderNotes          String                  @default("")
  /// Admin quotation response (simple Week 3 workflow)
  quoteMessage         String?
  quoteCurrency        String?
  quotedAt             DateTime?
  quotedByAdminId      String?
  traderResponseNote   String?
  confirmedAt          DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  /// Trader-declared destination — country name or Syria governorate name
  destinationCountry   String?
  /// Zone/governorate code into lib/shipping/rates.ts
  destinationCode      String?
  shippingMethodCode   String?
  shippingMethodLabel  String?
  /// Calculator estimate, not a charge — platform has no payment gateway
  shippingCostAmount   Decimal?
  shippingCostCurrency String?
  shippingWeightKg     Decimal?
  /// Stored/generated WhatsApp prefilled message text, built once the
  /// request reaches "confirmed" (trader accepted a quote, or admin
  /// confirmed a propose_price request)
  handoffMessageText   String?
  /// Built wa.me deep link — no WhatsApp Business API
  whatsAppDeepLink     String?
  handoffPreparedAt    DateTime?
  handoffOpenedAt      DateTime?
  /// D37b / Appendix S 8.3 — shipping fulfillment (nullable until set)
  carrier              String?
  trackingReference    String?
  shippedAt            DateTime?
  lines                WholesaleRequestLine[]
  events               WholesaleRequestEvent[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([traderId])
  @@index([status])
  @@index([requestMode])
}

model WholesaleRequestLine {
  id                         String           @id @default(cuid())
  requestId                  String
  request                    WholesaleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId                  String?
  product                    Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameAr              String
  productNameEn              String
  productSlugSnapshot        String
  quantity                   Int
  /// Trader-proposed unit price when requestMode=propose_price; null for request_quote
  proposedUnitPrice          Decimal?
  /// Admin-quoted unit price when a quotation is provided
  quotedUnitPrice            Decimal?
  currency                   String?
  /// Catalog retail at submission — informational reference ONLY (not wholesale pricing)
  catalogRetailPriceSnapshot Decimal?
  catalogCurrencySnapshot    String?
}

/// Auditable wholesale lifecycle events (not chat)
model WholesaleRequestEvent {
  id            String           @id @default(cuid())
  requestId     String
  request       WholesaleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// submitted | status_changed | quote_provided | trader_accepted | trader_declined
  eventType     String
  fromStatus    String?
  toStatus      String?
  /// trader | admin
  actorRole     String
  actorTraderId String?
  actorAdminId  String?
  note          String?
  createdAt     DateTime         @default(now())

  @@index([requestId])
}

/// WhatsApp communication domain — human admin desk (Baileys linked device).
/// Optional CRM FKs + one primary business-request link (not a merge).
model WhatsAppConversation {
  id                 String              @id @default(cuid())
  /// Stable WhatsApp chat JID (one-to-one). Unique conversation identity.
  waChatId           String              @unique
  remoteJid          String
  participantE164    String?
  displayName        String?
  lastMessageAt      DateTime?
  lastMessagePreview String              @default("")
  unreadCount        Int                 @default(0)
  /// Unread-for-trader counter — mirrors unreadCount (unread-for-admin) for
  /// outbound platform-channel messages the trader hasn't opened yet.
  traderUnreadCount  Int                 @default(0)
  /// none | retail_request | deal_proposal | wholesale_request | brokerage_request
  linkType           String              @default("none")
  /// Domain record id when linked; null when linkType=none
  linkId             String?
  linkedAt           DateTime?
  linkedByAdminId    String?
  /// Optional CRM party (owner confirms; may be suggested from phone)
  customerId         String?
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  traderId           String?
  trader             TraderAccount?      @relation(fields: [traderId], references: [id], onDelete: SetNull)
  messages           WhatsAppMessage[]
  linkAudits         WhatsAppLinkAudit[]
  notes              WhatsAppConversationNote[]
  /// Free-form labels an admin attaches to the conversation (round 3 inbox).
  tags               String[]            @default([])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([lastMessageAt])
  @@index([participantE164])
  @@index([linkType, linkId])
  @@index([customerId])
  @@index([traderId])
}

model WhatsAppMessage {
  id               String               @id @default(cuid())
  conversationId   String
  conversation     WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// inbound | outbound
  direction        String
  /// whatsapp | platform — platform = trader-portal in-app message, stored
  /// in the same conversation so WhatsApp + platform history stay unified
  channel          String               @default("whatsapp")
  /// text | image | video | audio | document | sticker | location | contact | unsupported
  messageType      String               @default("text")
  body             String               @default("")
  /// Optional caption for media; location/contact may store JSON in body
  caption          String?
  mediaMime        String?
  mediaSize        Int?
  mediaDurationSec Int?
  mediaFileName    String?
  mediaSha256      String?
  /// Relative key under storage/uploads/whatsapp — never a public URL
  storageKey       String?
  thumbnailKey     String?
  /// Baileys/WhatsApp message id — inbound idempotency (unique when present)
  waMessageId      String?              @unique
  /// Admin action idempotency key — outbound (unique when present)
  clientRequestId  String?              @unique
  /// received | pending(=queued) | sending | sent | delivered | read | failed
  status           String
  /// Outbound attempt counter (bounded retry). Inbound stays 0.
  attemptCount     Int                  @default(0)
  lastAttemptAt    DateTime?
  /// Earliest time a pending outbound may be claimed again (exponential backoff)
  nextRetryAt      DateTime?
  /// Safe operator error — never session/QR material
  errorSafe        String?
  /// WhatsApp-side timestamp when known
  waTimestamp      DateTime?
  adminId          String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([conversationId, createdAt])
  @@index([status])
  @@index([direction])
  @@index([nextRetryAt])
}

/// Persisted mirror of the in-memory outbound anti-ban rate limiter
/// (lib/whatsapp/outbound-safety.ts), single row. Exists only so a worker
/// restart (Docker `restart: unless-stopped` on crash, or a redeploy)
/// cannot silently reset the daily send cap or an open failure circuit —
/// without this, a crash loop could re-arm the full daily allowance on
/// every restart, defeating the cap's entire purpose. Hydrated once at
/// worker startup; the in-memory counters remain the fast path for every
/// per-message check.
model WhatsAppOutboundSafetyState {
  /// Always "default" — single worker state row
  id                String    @id @default("default")
  dayKey            String    @default("")
  dayCount          Int       @default(0)
  /// JSON array of epoch-ms send timestamps within the sliding burst window
  windowStampsJson  String    @default("[]")
  /// JSON array of epoch-ms timestamps of recent send failures
  failureStampsJson String    @default("[]")
  lastAttemptAt     DateTime?
  circuitOpenUntil  DateTime?
  updatedAt         DateTime  @updatedAt
}

/// Singleton connection health mirror for admin UI (Phase C). No secrets.
model WhatsAppConnectionHealth {
  /// Always "default" — single worker health row
  id               String    @id @default("default")
  /// CONNECTED | CONNECTING | DISCONNECTED | AUTHENTICATION_REQUIRED | ERROR
  state            String    @default("DISCONNECTED")
  detailSafe       String?
  lastConnectedAt  DateTime?
  /// Liveness ping the worker writes on an interval while CONNECTED — distinct
  /// from updatedAt, which only moves on an actual state transition and can
  /// otherwise sit unchanged for a healthy, long-running connection. Admin UI
  /// uses staleness of this field (not updatedAt) to catch a worker that died
  /// without a clean disconnect event leaving a stale "CONNECTED" row behind.
  lastHeartbeatAt  DateTime?
  updatedAt        DateTime  @updatedAt
  /// Admin pairing — E.164 digits of the phone being linked (no +)
  pairingPhone     String?
  /// Ephemeral pairing code for admin display only — cleared once connected
  pairingCode      String?
  /// Optional QR data URL for admin display only — cleared once connected
  qrDataUrl        String?
  /// none | pair | qr | reconnect | logout — consumed by the worker
  linkCommand      String?   @default("none")
  pairingExpiresAt DateTime?
  /// Runtime outbound kill (W1) — ANDed with WHATSAPP_OUTBOUND_ENABLED env.
  /// Flip from admin UI without restarting web/worker processes.
  outboundKillSwitch Boolean @default(false)
}

/// Durable inbox realtime log for SSE resume (Last-Event-ID) + LISTEN/NOTIFY.
/// Payload must stay free of phones, QR, session material, and full bodies.
model WhatsAppInboxEvent {
  id          String   @id @default(cuid())
  /// message.new | message.status | conversation.updated | connection.state
  type        String
  payloadJson String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// Simple auditable trail for explicit WhatsApp ↔ domain linking (Phase D).
model WhatsAppLinkAudit {
  id               String               @id @default(cuid())
  conversationId   String
  conversation     WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// set | change | clear
  action           String
  previousLinkType String?
  previousLinkId   String?
  /// none | retail_request | deal_proposal | wholesale_request
  newLinkType      String
  newLinkId        String?
  adminId          String
  createdAt        DateTime             @default(now())

  @@index([conversationId, createdAt])
  @@index([adminId])
}

/// Internal admin note on an inbox conversation (round 3) — never sent to the
/// customer, append-only (no edit/delete yet — matches the reference's own
/// minimal note display, which only ever shows existing notes).
model WhatsAppConversationNote {
  id             String               @id @default(cuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorAdminId  String
  /// Snapshot of the admin's display name at write time (survives a rename).
  authorName     String
  body           String
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
}

/// Fourth commercial domain — trader asks RARE OUD to inspect/source goods (VISION §7).
model BrokerageRequest {
  id                        String               @id @default(cuid())
  reference                 String               @unique
  traderId                  String
  trader                    TraderAccount        @relation(fields: [traderId], references: [id], onDelete: Restrict)
  /// SUBMITTED | NEEDS_INFO | AWAITING_PAYMENT | PAYMENT_CONFIRMED | ACCEPTED | INSPECTION_SCHEDULED | INSPECTED | QUOTE_SENT | APPROVED | PURCHASED | SHIPPED | DELIVERED | CLOSED | DECLINED | REJECTED | CANCELLED
  status                    String               @default("SUBMITTED")
  descriptionAr             String
  descriptionEn             String               @default("")
  /// Legacy free-text category — kept for old rows; new UI writes modelNumber
  categoryAr                String               @default("")
  categoryEn                String               @default("")
  /// Model / SKU (owner 2026-11-03 — replaces category on create)
  modelNumber               String               @default("")
  /// Trader-stated goods price in USD (payment-first; no admin quote gate)
  statedPriceUsd            Int?
  quantity                  Int                  @default(1)
  cityAr                    String               @default("")
  cityEn                    String               @default("")
  placeNameAr               String               @default("")
  placeNameEn               String               @default("")
  sellerContact             String               @default("")
  sourceUrl                 String               @default("")
  budgetMinUsd              Int?
  budgetMaxUsd              Int?
  timelineNotes             String               @default("")
  traderNotes               String               @default("")
  /// JSON string array of public image paths (trader request photos)
  photoPaths                String               @default("[]")
  adminDeclineReason        String               @default("")
  inspectionAt              DateTime?
  inspectionAssignee        String               @default("")
  inspectionLocation        String               @default("")
  carrier                   String               @default("")
  trackingRef               String               @default("")
  shippedAt                 DateTime?
  deliveredAt               DateTime?
  /// WhatsApp payment handoff (additive)
  handoffMessageText        String?
  whatsAppDeepLink          String?
  handoffPreparedAt         DateTime?
  handoffOpenedAt           DateTime?
  paymentConfirmedAt        DateTime?
  paymentConfirmedByAdminId String?
  inspection                BrokerageInspection?
  quote                     BrokerageQuote?
  events                    BrokerageEvent[]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@index([traderId, createdAt])
  @@index([status, createdAt])
}

model BrokerageInspection {
  id         String           @id @default(cuid())
  requestId  String           @unique
  request    BrokerageRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// A | B | C | D
  grade      String           @default("B")
  notesAr    String           @default("")
  notesEn    String           @default("")
  verdictAr  String           @default("")
  verdictEn  String           @default("")
  /// JSON string array of public image paths
  photoPaths String           @default("[]")
  checklist  String           @default("")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model BrokerageQuote {
  id             String           @id @default(cuid())
  requestId      String           @unique
  request        BrokerageRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  goodsValueUsd  Int
  /// 1.0 – 2.0
  commissionRate Float
  shippingUsd    Int              @default(0)
  notesAr        String           @default("")
  notesEn        String           @default("")
  validUntil     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model BrokerageEvent {
  id         String           @id @default(cuid())
  requestId  String
  request    BrokerageRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// status_change | note | system
  kind       String           @default("status_change")
  /// admin | trader | system
  actor      String
  fromStatus String?
  toStatus   String?
  messageAr  String           @default("")
  messageEn  String           @default("")
  createdAt  DateTime         @default(now())

  @@index([requestId, createdAt])
}
