    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "^1.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "lighthouse": "^12.2.1",
    "prisma": "6.19.3",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
