    "@whiskeysockets/baileys": "6.7.24",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.487.0",
    "next": "15.3.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
