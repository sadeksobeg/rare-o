    "test:whatsapp-phase-b": "node node_modules/tsx/dist/cli.mjs scripts/whatsapp-phase-b-checks.ts",
    "test:whatsapp-phase-c": "node node_modules/tsx/dist/cli.mjs scripts/whatsapp-phase-c-checks.ts",
    "test:whatsapp-phase-d": "node node_modules/tsx/dist/cli.mjs scripts/whatsapp-phase-d-checks.ts",
