# Copy to `.env.production` (never commit secrets). Used by docker-compose.prod.yml.

# Public hostname Caddy will obtain a cert for (A/AAAA must point at the VPS).
DOMAIN=example.com

# Postgres (internal compose network — do not expose 5432 publicly)
POSTGRES_USER=rareoud
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=rareoud
# App runtime — least-privilege role; TLS required in production
DATABASE_URL=postgresql://rareoud_app:replace-app-password@postgres:5432/rareoud?schema=public&sslmode=require

# App
AUTH_SECRET=replace-with-long-random-secret-at-least-32-chars
SITE_URL=https://example.com
SECURITY_EMAIL=security@example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_NAME=RARE OUD Admin
WHATSAPP_BUSINESS_E164=963900000000

# WhatsApp worker
WHATSAPP_ADAPTER=baileys
WHATSAPP_CONNECT_ON_START=false
WHATSAPP_OUTBOUND_ENABLED=false

# Backups kept under the rare_oud_backups volume
BACKUP_RETENTION_DAYS=7
