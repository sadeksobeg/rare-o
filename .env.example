DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-long-random-secret"
ADMIN_EMAIL="admin@rareoud.local"
ADMIN_PASSWORD="replace-with-strong-password"
ADMIN_NAME="RARE OUD Admin"
# Optional local trader seed (DEVELOPMENT ONLY — never production credentials)
TRADER_EMAIL="trader@rareoud.local"
TRADER_PASSWORD="replace-with-strong-password"
# Digits with country code, e.g. 9639XXXXXXXX (no +). Used for wa.me handoff only.
WHATSAPP_BUSINESS_E164="963900000000"

# --- Week 4 Stage A WhatsApp worker (Baileys) ---
# Private session directory (never under public/). Default: ./.wa-auth
# Production VPS example: /var/lib/rare-oud/whatsapp-auth
# WHATSAPP_AUTH_DIR="./.wa-auth"
# Open Baileys socket on worker start (default false until VPS/session ready)
WHATSAPP_CONNECT_ON_START="false"
# Outbound kill switch (default false — inbound still allowed when connected)
WHATSAPP_OUTBOUND_ENABLED="false"
